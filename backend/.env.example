# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
# DATABASE_URL: pooled connection (Supabase "Transaction" pooler, port 6543) — used at runtime.
# DIRECT_URL: direct connection (Supabase "Direct connection", port 5432) — used only by
#   `prisma migrate`, since the pooler doesn't support the prepared statements migrations need.
#   Optional: falls back to DATABASE_URL when there's no separate pooler (e.g. local Docker Postgres).
DATABASE_URL=
DIRECT_URL=

# JWT access tokens (short-lived, stateless)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# Refresh tokens (opaque, DB-backed sessions — see refresh_tokens table)
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_TTL_DAYS_REMEMBER=30

BCRYPT_SALT_ROUNDS=12

# Email verification / password reset token lifetimes
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Shared secret trusted only by the Next.js server, used to call
# server-to-server-only endpoints (e.g. /auth/oauth/upsert, /payments/*, /chat/completions)
INTERNAL_API_SECRET=

# SMTP (verification + password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Nexora <no-reply@example.com>"

# Cloudinary (server-side signed uploads — see /api/v1/uploads/signature)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# OpenAI (powers Chat Mr President AI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio (SMS + WhatsApp notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Web Push VAPID keys — generate with:
# npx web-push generate-vapid-keys
# The public key must also be set as NEXT_PUBLIC_VAPID_PUBLIC_KEY in apps/web.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
