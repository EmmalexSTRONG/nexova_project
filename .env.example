# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-only base URL for the Express API (falls back to NEXT_PUBLIC_API_URL if unset)
API_URL=http://localhost:4000

# Database (Supabase PostgreSQL) — only used if Prisma is invoked directly from this app
DATABASE_URL=

# NextAuth (Auth.js v5)
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Must exactly match apps/api's INTERNAL_API_SECRET — attached by expressInternalFetch()
# when calling server-to-server-only Express routes (payments, chat, notification dispatch).
INTERNAL_API_SECRET=

# Google Maps (client-side JS API — vendor location, distance/ETA, directions)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Web Push — must exactly match apps/api's VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Note: Paystack/Flutterwave/Cloudinary credentials live only in apps/api's env —
# this app never talks to those providers directly, only through the Express API.
